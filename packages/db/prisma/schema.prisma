generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SUPPORT_AGENT
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  PROPOSAL_SENT
  WON
  LOST
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  INTERACTIVE
  SYSTEM
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum NotificationType {
  SYSTEM
  BILLING
  LEAD
  APPOINTMENT
  CONVERSATION
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model Organization {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  phone           String?
  whatsappPhoneNumberId String?       @unique
  whatsappBusinessAccountId String?
  country         String              @default("AE")
  timezone        String              @default("Asia/Dubai")
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  users           User[]
  customers       Customer[]
  conversations   Conversation[]
  messages        Message[]
  leads           Lead[]
  appointments    Appointment[]
  documents       KnowledgeDocument[]
  chunks          KnowledgeChunk[]
  subscriptions   Subscription[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  businessHours   BusinessHour[]
}

model User {
  id             String         @id @default(cuid())
  organizationId String
  email          String         @unique
  name           String
  passwordHash   String
  role           UserRole       @default(SUPPORT_AGENT)
  isActive       Boolean        @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[] @relation("ConversationAssignee")
  sentMessages   Message[]      @relation("MessageSender")
  assignedLeads   Lead[]         @relation("LeadAssignee")
  appointments   Appointment[]
  businessHours   BusinessHour[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]

  @@index([organizationId])
  @@index([role])
  @@index([organizationId, role])
  @@index([organizationId, isActive])
}

model Customer {
  id             String         @id @default(cuid())
  organizationId String
  whatsappId     String?
  phone          String
  name           String?
  email          String?
  profileImageUrl String?
  locale         String?
  tags           String[]       @default([])
  metadata       Json?
  lastSeenAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  messages       Message[]
  leads          Lead[]
  appointments   Appointment[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([organizationId, whatsappId])
  @@index([phone])
}

model Conversation {
  id             String             @id @default(cuid())
  organizationId String
  customerId     String
  assignedToId   String?
  status         ConversationStatus @default(OPEN)
  channel        String             @default("WHATSAPP")
  subject        String?
  needsHuman     Boolean            @default(false)
  aiPausedAt     DateTime?
  aiLastIntent   String?
  aiConfidence   Float?
  language       String?
  lastMessageAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo     User?              @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages       Message[]
  appointments   Appointment[]

  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, needsHuman])
  @@index([assignedToId])
  @@index([organizationId, updatedAt])
  @@index([organizationId, status, updatedAt])
}

model Message {
  id             String           @id @default(cuid())
  organizationId String
  conversationId String
  customerId     String?
  senderUserId   String?
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  body           String?
  mediaUrl       String?
  providerMessageId String?
  metadata       Json?
  sentAt         DateTime         @default(now())
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  senderUser     User?            @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, providerMessageId])
  @@index([organizationId, conversationId])
  @@index([organizationId, sentAt])
  @@index([organizationId, direction])
  @@index([organizationId, direction, sentAt])
  @@index([organizationId, customerId, sentAt])
}

model Lead {
  id             String      @id @default(cuid())
  organizationId String
  customerId     String?
  assignedToId    String?
  name           String
  phone          String
  email          String?
  company        String?
  score          Int         @default(0)
  status         LeadStatus  @default(NEW)
  source         String      @default("WHATSAPP")
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo     User?       @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  appointments   Appointment[]

  @@index([organizationId, status])
  @@index([organizationId, phone])
  @@index([assignedToId])
  @@index([organizationId, score])
  @@index([organizationId, assignedToId])
  @@index([phone])
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  customerId     String?
  leadId         String?
  userId         String?
  conversationId String?
  title          String
  description    String?
  location       String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)
  source          String            @default("AI")
  metadata        Json?
  reminder24hSentAt DateTime?
  reminder1hSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead           Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation    Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
  @@index([organizationId, status])
  @@index([organizationId, reminder24hSentAt])
  @@index([organizationId, reminder1hSentAt])
  @@index([conversationId])
  @@index([organizationId, userId, status])
}

model KnowledgeDocument {
  id             String                  @id @default(cuid())
  organizationId String
  title          String
  sourceType     String
  sourceUrl      String?
  mimeType       String?
  contentHash    String?
  status         KnowledgeDocumentStatus @default(PENDING)
  metadata       Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks         KnowledgeChunk[]

  @@index([organizationId, status])
  @@index([organizationId, updatedAt])
}

model KnowledgeChunk {
  id             String            @id @default(cuid())
  organizationId String
  documentId     String
  content        String
  tokenCount     Int?
  chunkIndex     Int
  embedding      Unsupported("vector(1536)")?
  metadata       Json?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, documentId, chunkIndex])
  @@index([organizationId, documentId])
  @@index([documentId, chunkIndex])
}

model Plan {
  id                     String         @id @default(cuid())
  name                   String
  slug                   String         @unique
  stripePriceId          String?        @unique
  description            String?
  monthlyPriceAED        Int
  messageLimit           Int
  seatLimit              Int
  knowledgeDocumentLimit Int
  features               String[]       @default([])
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  subscriptions          Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  planId             String
  stripeCustomerId   String?
  stripeSubscriptionId String?          @unique
  stripeCheckoutSessionId String?
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  lastPaymentFailedAt DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
  @@index([stripeCustomerId])
  @@index([planId])
  @@index([organizationId, status, updatedAt])
}

model Notification {
  id             String             @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType
  status         NotificationStatus @default(UNREAD)
  title          String
  body           String
  metadata       Json?
  createdAt      DateTime           @default(now())
  readAt         DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([userId])
  @@index([organizationId, createdAt])
  @@index([userId, status])
}

model BusinessHour {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  dayOfWeek      Int
  opensAt        String
  closesAt       String
  slotMinutes    Int          @default(30)
  timezone       String       @default("Asia/Dubai")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, dayOfWeek, isActive])
}

model RefreshToken {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  tokenHash      String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
  @@index([organizationId, revokedAt])
}
