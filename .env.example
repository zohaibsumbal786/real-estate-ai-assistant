################################################################################
# DATABASE & REDIS
################################################################################
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dubai_ai_business_agent?schema=public"
REDIS_URL="redis://localhost:6379"
REDIS_OPTIONAL="true"

################################################################################
# SERVER & AUTH
################################################################################
PORT=4000
NODE_ENV="development"
JWT_ACCESS_SECRET="replace-with-a-long-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-a-long-refresh-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
WEB_ORIGIN="http://localhost:3000"

################################################################################
# WHATSAPP / META BUSINESS API
################################################################################
# Get these from: https://developers.facebook.com/
# For testing, you can use placeholder values
META_APP_SECRET="replace-with-meta-app-secret"
META_VERIFY_TOKEN="replace-with-your-random-token"

################################################################################
# OPENAI - AI & EMBEDDINGS
################################################################################
# MOCK MODE (development):
#   OPENAI_API_KEY="" (leave blank)
#   OPENAI_MOCK_RESPONSES="true"
#   → Returns canned responses for testing
#
# REAL MODE (production):
#   OPENAI_API_KEY="sk-proj-xxxxx" (from https://platform.openai.com/api-keys)
#   OPENAI_MOCK_RESPONSES="false"
#   → Uses real OpenAI API (charges your account)
#
# Start with MOCK MODE, enable REAL MODE when ready to deploy (see IMPLEMENTATION_GUIDE.md)

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_MOCK_RESPONSES="true"

################################################################################
# STRIPE - BILLING & PAYMENTS
################################################################################
# MOCK MODE (development):
#   STRIPE_SECRET_KEY="" (leave blank)
#   STRIPE_MOCK_CHECKOUT="true"
#   → Simulates successful checkouts locally, never charges
#
# REAL MODE (production):
#   STRIPE_SECRET_KEY="sk_live_xxxxx" (LIVE key from https://dashboard.stripe.com)
#   STRIPE_WEBHOOK_SECRET="whsec_xxxxx" (from Webhooks in Stripe dashboard)
#   STRIPE_MOCK_CHECKOUT="false"
#   → Uses real Stripe, actually charges credit cards
#
# To enable REAL MODE:
# 1. Sign up at stripe.com, verify UAE business
# 2. Go to Settings → API Keys → Live Mode
# 3. Copy Secret Key (sk_live_...)
# 4. Create webhook endpoint at https://yourdomain/api/billing/webhook
# 5. Copy Webhook Signing Secret (whsec_...)
# 6. Update these values below

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_MOCK_CHECKOUT="true"
BILLING_SUCCESS_URL="http://localhost:3000/en/dashboard?billing=success"
BILLING_CANCEL_URL="http://localhost:3000/en/dashboard?billing=cancelled"

################################################################################
# RATE LIMITING
################################################################################
RATE_LIMIT_WINDOW_MS=900000          # 15 minutes in milliseconds
RATE_LIMIT_MAX=300                   # 300 requests per IP per window
ORG_RATE_LIMIT_MAX=1500              # 1500 requests per org per window

################################################################################
# EMAIL (Optional - for alerts & reminders)
################################################################################
# Leave blank to disable email sending (alerts will log to console instead)
# Configure for production:
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
#   SMTP_USER="your-email@gmail.com"
#   SMTP_PASS="your-app-password"
#   EMAIL_FROM="Dubai AI <noreply@yourdomain.com>"

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Dubai AI Business Agent <no-reply@localhost>"
ALERT_EMAIL_TO="admin@demo.ae"

################################################################################
# NEXT STEPS
################################################################################
# 1. For LOCAL DEVELOPMENT:
#    - Keep OPENAI_MOCK_RESPONSES=true and STRIPE_MOCK_CHECKOUT=true
#    - Run: npm run dev
#
# 2. For PRODUCTION (see IMPLEMENTATION_GUIDE.md):
#    - Get OpenAI API key, set OPENAI_MOCK_RESPONSES=false
#    - Get Stripe live keys, set STRIPE_MOCK_CHECKOUT=false
#    - Set NODE_ENV=production
#    - Deploy with: npm run build && pm2 start ecosystem.config.cjs
#
# Questions? See README.md or IMPLEMENTATION_GUIDE.md

