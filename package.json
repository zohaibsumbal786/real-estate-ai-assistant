{
  "name": "dubai-ai-business-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm run dev --workspace @dubai-ai/api",
    "worker:knowledge": "npm run dev:worker:knowledge --workspace @dubai-ai/api",
    "worker:reminders": "npm run dev:worker:reminders --workspace @dubai-ai/api",
    "build": "npm run build --workspace @dubai-ai/db && npm run build --workspace @dubai-ai/api",
    "typecheck": "npm run typecheck --workspace @dubai-ai/db && npm run typecheck --workspace @dubai-ai/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace @dubai-ai/api",
    "simulate:whatsapp": "tsx apps/api/src/scripts/simulate-whatsapp-webhook.ts",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/src/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^6.10.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
